# Porta do servidor
PORT=3000

# Banco de dados PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=braslaminas

# Segredo do JWT (troque em producao!)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# =====================================================
# MODO DA APLICACAO
#   demo       -> simulacoes sem custo (frete, pagamento, rastreio)
#   production -> usa os provedores reais configurados abaixo
# =====================================================
APP_MODE=demo

# Provedor de pagamento: demo | mercadopago
PAYMENT_PROVIDER=demo

# Provedor de frete: demo | melhorenvio
SHIPPING_PROVIDER=demo

# Consulta de CEP via ViaCEP (true/false)
VIACEP_ENABLED=true

# Timeout (ms) das chamadas externas (ViaCEP, Melhor Envio, etc.)
PROVIDER_TIMEOUT_MS=5000

# =====================================================
# CREDENCIAIS REAIS (somente para production)
# NUNCA colocar valores no codigo nem commitar.
# =====================================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_WEBHOOK_SECRET=
