{
  "name": "braslaminas-backend",
  "version": "1.0.0",
  "description": "Backend da loja BrasLâminas - e-commerce de lâminas para microscopia",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/migrate.js && node scripts/seed.js",
    "test": "node --test"
  },
  "keywords": [
    "braslaminas",
    "ecommerce",
    "express",
    "postgres"
  ],
  "author": "BrasLâminas",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
